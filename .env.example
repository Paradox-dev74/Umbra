# ═══════════════════════════════════════════════════════════
# Umbra Protocol — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Fhenix (FHE Encryption) ──
NEXT_PUBLIC_FHENIX_RPC=https://api.helium.fhenix.zone
NEXT_PUBLIC_FHENIX_CHAIN_ID=8008135

# ── Privara / ReineiraOS (Settlement) ──
NEXT_PUBLIC_PRIVARA_API_URL=https://api.reineira.os/v1
PRIVARA_API_KEY=your_privara_api_key_here
PRIVARA_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Contract Addresses ──
NEXT_PUBLIC_UMBRA_CONTRACT=0x1234567890abcdef1234567890abcdef12345678

# ── WalletConnect ──
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── Chainlink Oracle (optional overrides) ──
NEXT_PUBLIC_ORACLE_ETH_USD=0x694AA1769357215DE4FAC081bf1f309aDC325306
NEXT_PUBLIC_ORACLE_BTC_USD=0x1b44F3514812d835EB1BDB0acB33d3fA3351Ee43
